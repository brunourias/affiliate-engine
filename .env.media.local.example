# Copie para .env.media.local e preencha somente com caminhos da sua máquina.
AFFILIATE_MEDIA_PIPELINE_MODE=LOCAL
AFFILIATE_FFMPEG_PATH=<caminho-para-ffmpeg.exe>
AFFILIATE_FFPROBE_PATH=<caminho-para-ffprobe.exe>
AFFILIATE_TTS_PROVIDER=PIPER
AFFILIATE_TTS_INVOCATION_MODE=MODULE
AFFILIATE_TTS_PYTHON_PATH=<caminho-para-python.exe>
AFFILIATE_TTS_PYTHON_MODULE=piper
AFFILIATE_TTS_MODEL_BRUNO=<caminho-para-modelo-bruno.onnx>
AFFILIATE_TTS_MODEL_CAROL=<caminho-para-modelo-carol.onnx>
AFFILIATE_TTS_MODEL_NARRATOR=<caminho-para-modelo-narrator.onnx>
