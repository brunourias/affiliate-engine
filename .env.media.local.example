# Copie para .env.media.local e preencha somente com caminhos da sua máquina.
AFFILIATE_MEDIA_PIPELINE_MODE=LOCAL
AFFILIATE_FFMPEG_PATH=<caminho-para-ffmpeg.exe>
AFFILIATE_FFPROBE_PATH=<caminho-para-ffprobe.exe>
AFFILIATE_TTS_PROVIDER=PIPER
AFFILIATE_TTS_INVOCATION_MODE=MODULE
AFFILIATE_TTS_PYTHON_PATH=<caminho-para-python.exe>
AFFILIATE_TTS_PYTHON_MODULE=piper
AFFILIATE_TTS_MODEL_BRUNO=<caminho-para-modelo-bruno.onnx>
AFFILIATE_TTS_MODEL_CAROL=<caminho-para-modelo-carol.onnx>
AFFILIATE_TTS_MODEL_NARRATOR=<caminho-para-modelo-narrator.onnx>

# Provider alternativo isolado (use CHATTERBOX acima e mantenha os paths locais fora do Git).
AFFILIATE_CHATTERBOX_PYTHON_PATH=<caminho-para-python-da-venv-chatterbox.exe>
AFFILIATE_CHATTERBOX_LANGUAGE=pt
AFFILIATE_CHATTERBOX_EXAGGERATION_BRUNO=0.60
AFFILIATE_CHATTERBOX_CFG_WEIGHT_BRUNO=0.40
AFFILIATE_CHATTERBOX_EXAGGERATION_CAROL=0.60
AFFILIATE_CHATTERBOX_CFG_WEIGHT_CAROL=0.40
AFFILIATE_CHATTERBOX_EXAGGERATION_NARRATOR=0.50
AFFILIATE_CHATTERBOX_CFG_WEIGHT_NARRATOR=0.45
AFFILIATE_CHATTERBOX_MODEL_LOAD_TIMEOUT_SECONDS=300
AFFILIATE_CHATTERBOX_SYNTHESIS_TIMEOUT_SECONDS=180
AFFILIATE_CHATTERBOX_DIAGNOSTIC_TIMEOUT_SECONDS=90
AFFILIATE_CHATTERBOX_TRIM_SILENCE_ENABLED=true
AFFILIATE_CHATTERBOX_TRIM_SILENCE_THRESHOLD_DB=-50
AFFILIATE_CHATTERBOX_TRIM_SILENCE_DURATION_SECONDS=0.15
AFFILIATE_CHATTERBOX_TRIM_SILENCE_PADDING_SECONDS=0.10
AFFILIATE_SUBTITLE_LEAD_IN_SECONDS=0.05
AFFILIATE_CHATTERBOX_REFERENCE_BRUNO=<caminho-relativo-opcional-em-data/media>
AFFILIATE_CHATTERBOX_REFERENCE_CAROL=<caminho-relativo-opcional-em-data/media>
AFFILIATE_CHATTERBOX_REFERENCE_NARRATOR=<caminho-relativo-opcional-em-data/media>
# JSON opcional, aplicado somente ao áudio. Ex.: {"móveis":"mobílias"}
AFFILIATE_TTS_PRONUNCIATION_OVERRIDES={}
